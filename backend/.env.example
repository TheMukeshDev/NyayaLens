# NyayaLens backend — environment variable template
#
# Copy to backend/.env and fill in real values. Never commit a real .env.
# The canonical template lives at the repository root: .env.example

# ---------------------------------------------------------------------------
# Supabase project — shared
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service-role key — bypasses RLS. Backend/server only. NEVER NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT secret from Supabase Dashboard -> Settings -> API (used to verify the
# Supabase Auth access tokens the backend receives).
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Optional raw connection strings for external SQL tooling (Supabase CLI).
# Application persistence goes through the Supabase client; these are unused
# by the API itself.
SUPABASE_DB_URL=
SUPABASE_DB_DIRECT_URL=

# ---------------------------------------------------------------------------
# Application endpoints
# ---------------------------------------------------------------------------
FRONTEND_URL=https://nyayalen.vercel.app
BACKEND_URL=https://nyaya-lens-ruby.vercel.app

# Shared secret for the scheduled document-processing drain
# (POST /api/v1/internal/process-documents). Vercel forwards it as a bearer
# token on cron invocations. REQUIRED when ENVIRONMENT=production.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# environment: development | testing | production
ENVIRONMENT=development
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins
CORS_ORIGINS=https://nyayalen.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Set false while the model quota is unavailable. Document and auth API routes
# remain available; model-dependent features return an honest unavailable state.
LLM_ENABLED=false

# Document upload limits (US-003)
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,jpg,jpeg,png

# ---------------------------------------------------------------------------
# Secure document storage (private Supabase Storage bucket)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=legal-documents
SIGNED_URL_EXPIRES_SECONDS=900

# ---------------------------------------------------------------------------
# AI embeddings + retrieval (docs/04_AI/AI-Architecture.md §16)
# ---------------------------------------------------------------------------
# Provider: deterministic (dev/test default) | openai-compatible (production).
EMBEDDING_PROVIDER=deterministic
# Configurable model identifier; recorded as per-chunk embedding metadata and
# reported by the provider. Change requires re-embedding each document.
EMBEDDING_MODEL=nyayalens/embeddings-deterministic-v1
# Optional vector dimension. Leave unset until the model is confirmed; run
# `ensure_embedding_index` with the confirmed dimension (see worker --ensure-embedding-index).
# EMBEDDING_DIMENSION=
# Batch size for embedding requests.
EMBEDDING_BATCH_SIZE=64
# OpenAI-compatible embeddings endpoint (only when EMBEDDING_PROVIDER=openai-compatible).
# EMBEDDING_API_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-YOUR_KEY
# Embedding request timeout (seconds) and retry policy (backend-only).
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_DELAY_SECONDS=1
EMBEDDING_RETRY_MAX_DELAY_SECONDS=10
# Client-side rate limit for embedding requests; 0 = unlimited.
EMBEDDING_MAX_REQUESTS_PER_MINUTE=0

# Initial retrieval target: top 8-12 chunks.
RETRIEVAL_TOP_K=10
# Relevance floor for candidate evidence.
RETRIEVAL_MIN_SIMILARITY=0.35

# ---------------------------------------------------------------------------
# AI generation — LLM provider (docs/04_AI/AI-Architecture.md §9-§15)
# ---------------------------------------------------------------------------
# The LLM is reached through an internal provider abstraction. Provider:
# openai-compatible (production path; PUT-compatible chat/completions endpoint).
LLM_PROVIDER=openai-compatible
# Model identifier; changes to the model require re-validation against the AI
# evaluation benchmark (docs/04_AI/AI-EVALUATION.md).
LLM_MODEL=
# OpenAI-compatible chat/completions endpoint.
LLM_API_URL=
# Backend/server-only API key. NEVER NEXT_PUBLIC_ — the frontend never sees it.
LLM_API_KEY=

# LLM call policy (backend-only): timeout, retries and rate limit.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=10
LLM_RETRY_JITTER_SECONDS=0
# Client-side rate limit for LLM requests; 0 = unlimited.
LLM_MAX_REQUESTS_PER_MINUTE=0