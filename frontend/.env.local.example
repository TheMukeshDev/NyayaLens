# Frontend-only environment. These values are safe to expose in the browser.
# Never place SUPABASE_SERVICE_ROLE_KEY or any backend secret in this file.
#
# The browser only ever reads the NEXT_PUBLIC_-prefixed names below; the
# unprefixed SUPABASE_URL / SUPABASE_ANON_KEY pair is server-side only and is
# never inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Hosted demo mode. Uses a cookie-backed mock account and never calls Supabase
# or the AI provider. Set false only when using a real Supabase project.
NEXT_PUBLIC_DEMO_MODE=true

# Demo login shown on the login page when demo mode is enabled:
# demo@nyayalens.com / NyayaDemo2026!

# NyayaLens backend API base URL — the deployed backend's public origin, with
# no trailing slash. Inlined at build time, so set it in your host's build
# environment. Leave empty to fall back to the same-origin proxy below.
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.vercel.app

# Optional same-origin fallback. Used only when NEXT_PUBLIC_API_URL is empty:
# the browser then calls /backend/api/v1/... and Next.js rewrites that to this
# origin server-side, so no CORS configuration is involved. Server-side only.
API_PROXY_TARGET=https://YOUR-BACKEND.vercel.app
