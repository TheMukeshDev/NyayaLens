# Copy to .env.local and fill in your Supabase project values.
# These are publishable (browser-safe) values: the project URL and anon key.
# NEVER put the service-role key in a NEXT_PUBLIC_ variable.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional hosted demo mode. Uses a cookie-backed mock account and never calls
# Supabase or the AI provider. Keep false or unset for real authentication.
NEXT_PUBLIC_DEMO_MODE=false

# NyayaLens backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
