# Frontend-only environment. These values are safe to expose in the browser.
# Never place SUPABASE_SERVICE_ROLE_KEY or any backend secret in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional hosted demo mode. Uses a cookie-backed mock account and never calls
# Supabase or the AI provider. Keep false or unset for real authentication.
NEXT_PUBLIC_DEMO_MODE=true

# NyayaLens backend API base URL.
NEXT_PUBLIC_API_URL=https://nyaya-lens-ruby.vercel.app
