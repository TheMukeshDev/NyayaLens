# NyayaLens — environment variable template
#
# Copy values into your local environment as appropriate:
#   - backend:  `<env> SUPABASE_URL=...` or a backend/.env file
#   - frontend: variables prefixed NEXT_PUBLIC_ are read at build time
#               (frontend/.env.local or the hosting provider)
#
# Never commit a real .env file. Only this .env.example is committed.
# All values below are PLACEHOLDERS.

# ---------------------------------------------------------------------------
# Supabase project — shared
# ---------------------------------------------------------------------------
# The project URL and anon key are the same values everywhere. The NEXT_PUBLIC_
# prefixed duplicates below exist ONLY so the browser bundle can inline them at
# build time; there is no separate "frontend" project URL or key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---------------------------------------------------------------------------
# Frontend — Supabase client (safe for browser exposure)
# ---------------------------------------------------------------------------
# Same values as SUPABASE_URL / SUPABASE_ANON_KEY above; the NEXT_PUBLIC_ prefix
# is required for Next.js to inline them into the client bundle at build time.
# The browser never sees SUPABASE_URL/SUPABASE_ANON_KEY, so these two names —
# not the unprefixed ones — are what the client actually uses.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional hosted demo mode: a cookie-backed mock account that calls neither
# Supabase nor the AI provider. Keep false/unset for real authentication.
NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# NyayaLens API — where the browser sends /api/v1 requests
# ---------------------------------------------------------------------------
# Public origin of the deployed backend, no trailing slash. This is inlined into
# the client bundle at build time, so it must be set in the hosting provider's
# build environment, not just at runtime.
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.vercel.app

# Optional. When NEXT_PUBLIC_API_URL is empty, the browser calls the same-origin
# path /backend/api/v1/... and Next.js proxies it to this origin server-side,
# which sidesteps CORS entirely. Server-side only; never NEXT_PUBLIC_.
API_PROXY_TARGET=https://YOUR-BACKEND.vercel.app

# ---------------------------------------------------------------------------
# Backend — Supabase server-side access (TRUSTED environment ONLY)
# ---------------------------------------------------------------------------
# The service-role key bypasses RLS and must exist ONLY on the backend/server.
# It is also used by the backend for private Supabase Storage operations.
# It must never be exposed to the frontend or committed.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Connection string for the Supabase-hosted PostgreSQL database
# (uses the database password, not the service-role key).
# Required by SQLAlchemy/Alembic; obtained from Supabase Dashboard -> Settings -> Database.
# The backend reads this as SUPABASE_DB_URL (DATABASE_URL is accepted as a
# local-development fallback only).
SUPABASE_DB_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional direct (non-pooled) connection string — used by Alembic migrations
# when the pooler should be bypassed. Omit if unused.
SUPABASE_DB_DIRECT_URL=

# ---------------------------------------------------------------------------
# Application endpoints (backend only)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Shared secret for the serverless document-processing drain
# (POST /api/v1/internal/process-documents). Vercel sends it as the
# `x-vercel-cron-signature`/`Authorization: Bearer` header on cron invocations.
# REQUIRED when ENVIRONMENT=production; generate with `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Backend runtime configuration
# ---------------------------------------------------------------------------
# Vector index tuning / embedding dimension; must match the deployed embedding model
EMBEDDING_DIMENSION=1536

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime environment: development | testing | production
ENVIRONMENT=development
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Document upload limits (US-003)
MAX_UPLOAD_SIZE_MB=20
# Comma-separated list of allowed file extensions (PDF, DOCX, JPG/JPEG, PNG)
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,jpg,jpeg,png

# ---------------------------------------------------------------------------
# Backend — secure document storage (server-side private bucket)
# ---------------------------------------------------------------------------
# Private Supabase Storage bucket for legal documents (MUST never be public).
# Created by supabase/migrations/..._storage_legal_documents.sql.
STORAGE_BUCKET=legal-documents
# Lifetime (seconds) of short-lived signed URLs issued for browser access.
SIGNED_URL_EXPIRES_SECONDS=900

# ---------------------------------------------------------------------------
# AI provider keys (backend-only; never exposed to the frontend)
# ---------------------------------------------------------------------------
# LLM used for document analysis / grounded Q&A
LLM_API_KEY=
# Embedding model used to generate vectors stored in pgvector
EMBEDDING_API_KEY=